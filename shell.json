{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true,
        "desktopClock": {
        "enabled": true,
        "scale": 1.0,
        "position": "top-right",
        "background": {
        "enabled": true,
        "opacity": 0.6,
        "blur": true
      },
      "shadow": {
        "enabled": true,
        "opacity": 0.5,
        "blur": 0.5
      }
    },
    "visualiser": {
      "enabled": true,
      "autoHide": true,
      "blur": false,
      "rounding": 1,
      "spacing": 1
    }
      
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": false,
            "showOnHover": true
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showIcon": false,
            "showSeconds": false
        },
        "persistent": true,
        "popouts": {
            "tray": true
        },
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "microphone"
            },
            {
                "enabled": true,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": false,
                "id": "bluetooth"
            },
            {
                "enabled": false,
                "id": "battery"
            }
        ],
        "tray": {
            "background": false,
            "compact": true,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "maxWindowIcons": 5,
            "occupiedBg": false,
            "perMonitor": true,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 5
        }
    },
    "dashboard": {
        "showClockSeconds": true
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "terminal": [
                "foot"
            ]
        }
    },
    "launcher": {
        "actionPrefix": ">",
        "enableDangerousActions": true,
        "favouriteApps": [
            "brave-origin",
            "kitty",
            "spotify",
            "codium",
            "org.gnome.Nautilus"
        ],
        "showOnHover": false,
        "useFuzzy": {
            "variants": false,
            "wallpapers": false
        }
    },
    "notifs": {
        "fullscreen": "Off"
    },
    "utilities": {
        "toasts": {
            "nowPlaying": true
        }
    }
}
